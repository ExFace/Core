<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Block dot-prefixed files and folders at any depth, including all folder contents. -->
                <rule name="dot-prefixed files and folders" stopProcessing="true">
                    <match url="(^|/)\." ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="API requests" stopProcessing="true">
                    <match url="^api/.*$" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="vendor/exface/core/index.php" appendQueryString="true" />
                </rule>
                <rule name="Root request" stopProcessing="true">
                    <match url="^$" ignoreCase="false" />
                    <action type="Rewrite" url="vendor/exface/core/index.php" appendQueryString="true" />
                </rule>
                <rule name="*.html files in root folder" stopProcessing="true">
                    <match url="^[^/]*\.html$" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="vendor/exface/core/index.php" appendQueryString="true" />
                </rule>
                <rule name="sensitive folders">
                    <match url="^(config|backup|translations|logs)/.*$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <!-- Block files directly in vendor (including SBOMs), but not files in subfolders. -->
                <rule name="files directly in vendor folder" stopProcessing="true">
                    <match url="^vendor/[^/]+$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <!-- Block direct access to .html, .htm and .md files in vendor. -->
                <rule name="HTML and Markdown files in vendor folder" stopProcessing="true">
                    <match url="^vendor/.*\.(html?|md)$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="gh-docs folders" stopProcessing="true">
                    <match url="^vendor/.*/gh-pages.*$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
            </rules>
        </rewrite>
		<security>
			<requestFiltering removeServerHeader="true">
				<requestLimits maxUrl="32768" maxQueryString="32768" />
			</requestFiltering>
		</security>
	</system.webServer>
	<system.web>
		<httpRuntime maxQueryStringLength="32768" maxUrlLength="65536" />
	</system.web>    
</configuration>